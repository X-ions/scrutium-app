APP_NAME=Scrutium
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Neon / Postgres (Vercel Storage injects DATABASE_URL automatically)
DB_CONNECTION=pgsql
DB_SSLMODE=require
DB_URL=
DATABASE_URL=
# Optional discrete Neon parameters:
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=
# DB_PASSWORD=

# First production boot creates tables when this is true
SCRUTIUM_AUTO_MIGRATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Use the configured durable storage disk in production.
FILESYSTEM_DISK=s3
EVIDENCE_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

# Production object storage / Neon Storage Data API (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=scrutium-production
AWS_ENDPOINT=https://<your-neon-storage-endpoint>
AWS_URL=https://<your-neon-storage-endpoint>/<your-bucket>
AWS_USE_PATH_STYLE_ENDPOINT=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Set this to an address on a domain verified with Resend.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SocialHub CMS — social providers
# ---------------------------------------------------------------------------
# Every value below is a PLACEHOLDER and intentionally empty. A provider with
# blank credentials reports status "not_configured" and its publish
# affordances are hidden in the UI; it is never faked. Set the real values in
# your own .env (never in git) and run `php artisan socialhub:doctor`, which
# prints only set/missing — never a secret.
#
# Meta (Facebook + Instagram) — App Review required for publishing scopes.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# YouTube — unverified apps are limited to 100 test users.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# TikTok — App Audit required for non-approved clients.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X — elevated (paid) access tier required for write endpoints.
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — organization page posting needs w_organization_manage.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pinterest.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# SocialHub CMS — runtime
# ---------------------------------------------------------------------------
# Optional dedicated 32-byte base64 key for encrypting social tokens at rest,
# separate from APP_KEY. Leave blank to use APP_KEY.
SOCIALHUB_TOKEN_KEY=
# Queue connection for publishing, analytics and webhook jobs. Blank uses the
# application's default connection.
SOCIALHUB_QUEUE=
# Filesystem disk that holds media assets. Blank uses "local".
SOCIALHUB_MEDIA_DISK=
